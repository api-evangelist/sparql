          "name": "Execute SPARQL Query via GET",
          "request": {
            "name": "Execute SPARQL Query via GET",
            "description": {
              "content": "Executes a SPARQL query operation using HTTP GET. The query string is passed as a URL parameter. This method is suitable for queries that fit within URL length limits. Supports SELECT, ASK, CONSTRUCT, and DESCRIBE query forms.",
              "type": "text/plain"
            },
            "url": {
