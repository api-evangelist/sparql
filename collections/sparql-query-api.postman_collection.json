        {
          "id": "7647ea46-b413-49a3-8a95-cd34e54a1d5f",
          "name": "Execute a SPARQL query via POST",
          "request": {
            "name": "Execute a SPARQL query via POST",
            "description": {
              "content": "Executes a SPARQL query via POST. Two encodings are defined by the\nSPARQL 1.1 Protocol:\n\n* `application/x-www-form-urlencoded` — the body carries the same\n  parameters as the GET variant (`query`, `default-graph-uri`,\n  `named-graph-uri`).\n* `application/sparql-query` — the body IS the SPARQL query string,\n  in UTF-8, and `default-graph-uri` / `named-graph-uri` may still\n  appear in the URL query string.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sparql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "default-graph-uri",
                  "value": "<uri>"
                },
                {
                  "disabled": false,
                  "key": "default-graph-uri",
                  "value": "<uri>"
                },
